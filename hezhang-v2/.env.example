# Docker Compose 会提供 DATABASE_URL。仅本地运行时才需要自行设置。
DATABASE_URL=postgres://hezhang:change_me@localhost:5432/hezhang
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-long-one-time-token
PORT=3000
MAX_UPLOAD_MB=10
